FROM https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2025-12-04/2025-12-04-raspios-trixie-arm64-lite.img.xz
# TO aura-image.img

# make room to install packages
PUMP 100M

# update repos
RUN apt update
# install required packages
RUN apt install -y libeigen3-dev

# set root password
# user: root, password: password
RUN bash -c "echo \"root:password\" | chpasswd"

# configure uart, enables uart port and creates a uart shell
RUN raspi-config nonint do_serial_hw 0
RUN raspi-config nonint do_serial_cons 0

# create systemd override directories for serial auto-login
RUN mkdir -p /etc/systemd/system/serial-getty@ttyAMA0.service.d
RUN mkdir -p /etc/systemd/system/serial-getty@ttyS0.service.d

# install serial auto-login configuration for both common uart devices
INSTALL image/serial-autologin.conf /etc/systemd/system/serial-getty@ttyAMA0.service.d/autologin.conf
INSTALL image/serial-autologin.conf /etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf

# shrink image back down, removes uneccessary space
SHRINK

